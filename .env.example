# Copy to .env. docker-compose reads it; for a non-Docker setup, export these in your shell.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Extra origins allowed to post forms (comma-separated), e.g. https://nepse.example.com behind a proxy.
DJANGO_CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=nepse
POSTGRES_USER=nepse
POSTGRES_PASSWORD=nepse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis db 0 = Celery broker, 1 = results, 2 = cache and locks.
REDIS_URL=redis://localhost:6379

# Snapshot sources, tried in order.
MARKETDATA_SOURCES=sharesansar,merolagani

# Email. Leave EMAIL_HOST empty to print emails to the console instead of sending.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=NEPSE Notifier <alerts@example.com>
# Public URL of the Django app, used in unsubscribe links.
SITE_URL=http://localhost:8000
